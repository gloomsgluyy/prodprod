# CoalTrade OS — Production Environment Variables
# Copy this file to .env and fill in REAL values
# NEVER commit .env to version control

# ── Database ──────────────────────────────────────────────────────────────────
# PgBouncer (runtime queries) — REQUIRED for production
DATABASE_URL="postgresql://coaltrade_app:CHANGE_ME@127.0.0.1:6543/coaltrade_production?pgbouncer=true"
# Direct connection (migrations only)
DIRECT_URL="postgresql://coaltrade_app:CHANGE_ME@127.0.0.1:5432/coaltrade_production"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Your production domain (with https)
NEXTAUTH_URL="https://yourdomain.com"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="GENERATE_WITH_openssl_rand_base64_32"

# ── Redis (pick ONE option) ──────────────────────────────────────────────────
# Option A: Local Redis on VPS (recommended — zero latency)
REDIS_URL="redis://:REDIS_PASSWORD@127.0.0.1:6379"

# Option B: Upstash Redis (managed, edge-compatible)
# UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"

# ── Groq AI (market scraping, transcription, due diligence) ──────────────────
GROQ_API_KEY="gsk_..."

# ── Cron job security ────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
CRON_SECRET="GENERATE_WITH_openssl_rand_hex_32"

# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV="production"
