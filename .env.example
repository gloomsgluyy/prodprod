# Database — use pooler URL for runtime, direct for migrations
DATABASE_URL="postgresql://user:password@pooler-host:6543/coaltrade?pgbouncer=true"
DIRECT_URL="postgresql://user:password@db-host:5432/coaltrade"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Upstash Redis (edge cache)
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# Groq AI (market scraping, transcription, due diligence)
GROQ_API_KEY="gsk_..."

# Cron job security
CRON_SECRET="generate-random-secret"
